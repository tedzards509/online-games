{
  "openapi": "3.1.0",
  "info": {
    "title": "Friends' Arena",
    "description": "Anonymous rooms. HTTP uses bearer room tokens. WebSockets authenticate in the first frame; see ClientMessage and ServerMessage schemas.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [],
        "operationId": "health",
        "responses": {
          "204": {
            "description": "Ready"
          }
        }
      }
    },
    "/api/rooms": {
      "post": {
        "tags": [],
        "operationId": "create_room",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRoom"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Membership"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/rooms/{code}": {
      "get": {
        "tags": [],
        "operationId": "room_snapshot",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "room_token": []
          }
        ]
      }
    },
    "/api/rooms/{code}/join": {
      "post": {
        "tags": [],
        "operationId": "join_room",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinRoom"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Membership"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/rooms/{code}/replays/{id}": {
      "get": {
        "tags": [],
        "operationId": "replay",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Replay"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "room_token": []
          }
        ]
      }
    },
    "/api/rooms/{code}/ws": {
      "get": {
        "tags": [],
        "operationId": "websocket",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "101": {
            "description": "Per-room WebSocket. Authenticate first, then Start or Move. Receives personalized Snapshots and Errors."
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Action": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "action",
              "game"
            ],
            "properties": {
              "action": {
                "$ref": "#/components/schemas/MancalaAction"
              },
              "game": {
                "type": "string",
                "enum": [
                  "mancala"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "action",
              "game"
            ],
            "properties": {
              "action": {
                "$ref": "#/components/schemas/CrazyEightsAction"
              },
              "game": {
                "type": "string",
                "enum": [
                  "crazy_eights"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "action",
              "game"
            ],
            "properties": {
              "action": {
                "$ref": "#/components/schemas/ShitheadAction"
              },
              "game": {
                "type": "string",
                "enum": [
                  "shithead"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "action",
              "game"
            ],
            "properties": {
              "action": {
                "$ref": "#/components/schemas/SkyjoAction"
              },
              "game": {
                "type": "string",
                "enum": [
                  "skyjo"
                ]
              }
            }
          }
        ]
      },
      "Card": {
        "type": "object",
        "description": "Ranks run from two (2) to ace (14).",
        "required": [
          "suit",
          "rank"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "suit": {
            "$ref": "#/components/schemas/Suit"
          }
        }
      },
      "CellView": {
        "type": "object",
        "required": [
          "removed"
        ],
        "properties": {
          "removed": {
            "type": "boolean"
          },
          "value": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        }
      },
      "ClientMessage": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "token",
              "type"
            ],
            "properties": {
              "token": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "authenticate"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "revision",
              "type"
            ],
            "properties": {
              "revision": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "type": {
                "type": "string",
                "enum": [
                  "start"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "revision",
              "action",
              "type"
            ],
            "properties": {
              "action": {
                "$ref": "#/components/schemas/Action"
              },
              "revision": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "type": {
                "type": "string",
                "enum": [
                  "move"
                ]
              }
            }
          }
        ],
        "description": "Send Authenticate as the first text frame within five seconds. Subsequent\ncommands must carry the most recent Snapshot revision."
      },
      "CrazyEightsAction": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "index",
              "type"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "suit": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/Suit"
                  }
                ]
              },
              "type": {
                "type": "string",
                "enum": [
                  "play"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "draw"
                ]
              }
            }
          }
        ]
      },
      "CrazyEightsView": {
        "type": "object",
        "required": [
          "hand",
          "counts",
          "top",
          "suit",
          "stock"
        ],
        "properties": {
          "counts": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "hand": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Card"
            }
          },
          "stock": {
            "type": "integer",
            "minimum": 0
          },
          "suit": {
            "$ref": "#/components/schemas/Suit"
          },
          "top": {
            "$ref": "#/components/schemas/Card"
          }
        }
      },
      "CreateRoom": {
        "type": "object",
        "required": [
          "nickname",
          "game"
        ],
        "properties": {
          "game": {
            "$ref": "#/components/schemas/GameKind"
          },
          "nickname": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Event": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "player",
              "type"
            ],
            "properties": {
              "player": {
                "$ref": "#/components/schemas/usize"
              },
              "type": {
                "type": "string",
                "enum": [
                  "played"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "player",
              "count",
              "type"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "player": {
                "$ref": "#/components/schemas/usize"
              },
              "type": {
                "type": "string",
                "enum": [
                  "captured"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "burned"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "player",
              "column",
              "type"
            ],
            "properties": {
              "column": {
                "type": "integer",
                "minimum": 0
              },
              "player": {
                "$ref": "#/components/schemas/usize"
              },
              "type": {
                "type": "string",
                "enum": [
                  "column_removed"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "outcome",
              "type"
            ],
            "properties": {
              "outcome": {
                "$ref": "#/components/schemas/Outcome"
              },
              "type": {
                "type": "string",
                "enum": [
                  "finished"
                ]
              }
            }
          }
        ]
      },
      "GameKind": {
        "type": "string",
        "enum": [
          "mancala",
          "crazy_eights",
          "shithead",
          "skyjo"
        ]
      },
      "JoinRoom": {
        "type": "object",
        "required": [
          "nickname"
        ],
        "properties": {
          "nickname": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "MancalaAction": {
        "type": "object",
        "required": [
          "pit"
        ],
        "properties": {
          "pit": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "MancalaView": {
        "type": "object",
        "required": [
          "board"
        ],
        "properties": {
          "board": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        }
      },
      "Membership": {
        "type": "object",
        "description": "Keep the token private. It grants control of this seat, including after reconnecting.",
        "required": [
          "code",
          "player",
          "token"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "player": {
            "type": "integer",
            "minimum": 0
          },
          "token": {
            "type": "string"
          }
        }
      },
      "Outcome": {
        "type": "object",
        "required": [
          "winners"
        ],
        "properties": {
          "scores": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "winners": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/usize"
            }
          }
        }
      },
      "Phase": {
        "type": "string",
        "enum": [
          "setup",
          "draw",
          "place",
          "reveal"
        ]
      },
      "PlayerView": {
        "type": "object",
        "required": [
          "nickname"
        ],
        "properties": {
          "nickname": {
            "type": "string"
          }
        }
      },
      "Record_Action": {
        "type": "object",
        "required": [
          "player",
          "action",
          "events"
        ],
        "properties": {
          "action": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "action",
                  "game"
                ],
                "properties": {
                  "action": {
                    "$ref": "#/components/schemas/MancalaAction"
                  },
                  "game": {
                    "type": "string",
                    "enum": [
                      "mancala"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "action",
                  "game"
                ],
                "properties": {
                  "action": {
                    "$ref": "#/components/schemas/CrazyEightsAction"
                  },
                  "game": {
                    "type": "string",
                    "enum": [
                      "crazy_eights"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "action",
                  "game"
                ],
                "properties": {
                  "action": {
                    "$ref": "#/components/schemas/ShitheadAction"
                  },
                  "game": {
                    "type": "string",
                    "enum": [
                      "shithead"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "action",
                  "game"
                ],
                "properties": {
                  "action": {
                    "$ref": "#/components/schemas/SkyjoAction"
                  },
                  "game": {
                    "type": "string",
                    "enum": [
                      "skyjo"
                    ]
                  }
                }
              }
            ]
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          },
          "player": {
            "$ref": "#/components/schemas/usize"
          }
        }
      },
      "Replay": {
        "type": "object",
        "description": "Includes hidden information; only share after the game has ended.",
        "required": [
          "version",
          "game",
          "players",
          "seed",
          "records"
        ],
        "properties": {
          "game": {
            "$ref": "#/components/schemas/GameKind"
          },
          "players": {
            "type": "integer",
            "minimum": 0
          },
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Record_Action"
            }
          },
          "seed": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            },
            "maxItems": 32,
            "minItems": 32
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "ServerMessage": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "room",
              "type"
            ],
            "properties": {
              "room": {
                "$ref": "#/components/schemas/Snapshot"
              },
              "type": {
                "type": "string",
                "enum": [
                  "snapshot"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "error",
              "type"
            ],
            "properties": {
              "error": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "error"
                ]
              }
            }
          }
        ]
      },
      "ShitheadAction": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "indices",
              "type"
            ],
            "properties": {
              "indices": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "type": {
                "type": "string",
                "enum": [
                  "play"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "index",
              "type"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "type": {
                "type": "string",
                "enum": [
                  "blind"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "pickup"
                ]
              }
            }
          }
        ]
      },
      "ShitheadPlayerView": {
        "type": "object",
        "required": [
          "count",
          "up",
          "down"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "down": {
            "type": "integer",
            "minimum": 0
          },
          "up": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Card"
            }
          }
        }
      },
      "ShitheadView": {
        "type": "object",
        "required": [
          "hand",
          "players",
          "pile",
          "stock",
          "burned",
          "finished"
        ],
        "properties": {
          "burned": {
            "type": "integer",
            "minimum": 0
          },
          "finished": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/usize"
            }
          },
          "hand": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Card"
            }
          },
          "pile": {
            "type": "integer",
            "minimum": 0
          },
          "players": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShitheadPlayerView"
            }
          },
          "stock": {
            "type": "integer",
            "minimum": 0
          },
          "top": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Card"
              }
            ]
          }
        }
      },
      "SkyjoAction": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "index",
              "type"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "type": {
                "type": "string",
                "enum": [
                  "reveal"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "source",
              "type"
            ],
            "properties": {
              "source": {
                "$ref": "#/components/schemas/Source"
              },
              "type": {
                "type": "string",
                "enum": [
                  "draw"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "index",
              "type"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "type": {
                "type": "string",
                "enum": [
                  "replace"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "discard"
                ]
              }
            }
          }
        ]
      },
      "SkyjoView": {
        "type": "object",
        "required": [
          "grids",
          "stock",
          "phase"
        ],
        "properties": {
          "finisher": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/usize"
              }
            ]
          },
          "grids": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/CellView"
              }
            }
          },
          "pending": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "phase": {
            "$ref": "#/components/schemas/Phase"
          },
          "stock": {
            "type": "integer",
            "minimum": 0
          },
          "top": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        }
      },
      "Snapshot": {
        "type": "object",
        "required": [
          "code",
          "game",
          "players",
          "you",
          "revision",
