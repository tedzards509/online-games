{
  "openapi": "3.1.0",
  "info": {
    "title": "Friends' Arena",
    "description": "Anonymous rooms. HTTP uses bearer room tokens. WebSockets authenticate in the first frame; see ClientMessage and ServerMessage schemas.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [],
        "operationId": "health",
        "responses": {
          "204": {
            "description": "Ready"
          }
        }
      }
    },
    "/api/rooms": {
      "post": {
        "tags": [],
        "operationId": "create_room",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRoom"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Membership"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/rooms/{code}": {
      "get": {
        "tags": [],
        "operationId": "room_snapshot",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "room_token": []
          }
        ]
      }
    },
    "/api/rooms/{code}/join": {
      "post": {
        "tags": [],
        "operationId": "join_room",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinRoom"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Membership"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/rooms/{code}/replays/{id}": {
      "get": {
        "tags": [],
        "operationId": "replay",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Replay"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "room_token": []
          }
        ]
      }
    },
    "/api/rooms/{code}/ws": {
      "get": {
        "tags": [],
        "operationId": "websocket",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "101": {
            "description": "Per-room WebSocket. Authenticate first, then Start or Move. Receives personalized Snapshots and Errors."
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Action": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "action",
              "game"
            ],
            "properties": {
              "action": {
                "$ref": "#/components/schemas/MancalaAction"
              },
              "game": {
                "type": "string",
                "enum": [
                  "mancala"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "action",
              "game"
            ],
            "properties": {
              "action": {
                "$ref": "#/components/schemas/CrazyEightsAction"
              },
              "game": {
                "type": "string",
                "enum": [
                  "crazy_eights"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "action",
              "game"
            ],
            "properties": {
              "action": {
                "$ref": "#/components/schemas/ShitheadAction"
              },
              "game": {
                "type": "string",
                "enum": [
                  "shithead"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "action",
              "game"
            ],
            "properties": {
              "action": {
                "$ref": "#/components/schemas/SkyjoAction"
              },
              "game": {
                "type": "string",
                "enum": [
                  "skyjo"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "action",
              "game"
            ],
            "properties": {
              "action": {
                "$ref": "#/components/schemas/TicTacToeAction"
              },
              "game": {
                "type": "string",
                "enum": [
                  "tic_tac_toe"
                ]
              }
            }
          }
        ],
        "description": "A command tagged with the ruleset that understands it."
      },
      "Card": {
        "type": "object",
        "description": "A standard playing card; ranks run from two (2) to ace (14).",
        "required": [
          "suit",
          "rank"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "format": "int32",
            "description": "The card's rank, from 2 to 14.",
            "minimum": 0
          },
          "suit": {
            "$ref": "#/components/schemas/Suit",
            "description": "The card's printed suit."
          }
        }
      },
      "CellView": {
        "type": "object",
        "required": [
          "removed"
        ],
        "properties": {
          "removed": {
            "type": "boolean"
          },
          "value": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        }
      },
      "ClientMessage": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "token",
              "type"
            ],
            "properties": {
              "token": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "authenticate"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "revision",
              "type"
            ],
            "properties": {
              "revision": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "type": {
                "type": "string",
                "enum": [
                  "start"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "revision",
              "action",
              "type"
            ],
            "properties": {
              "action": {
                "$ref": "#/components/schemas/Action"
              },
              "revision": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "type": {
                "type": "string",
                "enum": [
                  "move"
                ]
              }
            }
          }
        ],
        "description": "Send Authenticate as the first text frame within five seconds. Subsequent\ncommands must carry the most recent Snapshot revision."
      },
      "Config": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "rules",
              "game"
            ],
            "properties": {
              "game": {
                "type": "string",
                "enum": [
                  "mancala"
                ]
              },
              "rules": {
                "$ref": "#/components/schemas/GameConfig"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "rules",
              "game"
            ],
            "properties": {
              "game": {
                "type": "string",
                "enum": [
                  "crazy_eights"
                ]
              },
              "rules": {
                "$ref": "#/components/schemas/CrazyEightsGameConfig"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "rules",
              "game"
            ],
            "properties": {
              "game": {
                "type": "string",
                "enum": [
                  "shithead"
                ]
              },
              "rules": {
                "$ref": "#/components/schemas/GameConfig"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "rules",
              "game"
            ],
            "properties": {
              "game": {
                "type": "string",
                "enum": [
                  "skyjo"
                ]
              },
              "rules": {
                "$ref": "#/components/schemas/GameConfig"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "rules",
              "game"
            ],
            "properties": {
              "game": {
                "type": "string",
                "enum": [
                  "tic_tac_toe"
                ]
              },
              "rules": {
                "$ref": "#/components/schemas/GameConfig"
              }
            }
          }
        ],
        "description": "Setup options tagged with the ruleset that defines their `GameConfig` struct."
      },
      "CrazyEightsAction": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "index",
              "type"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "suit": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/Suit"
                  }
                ]
              },
              "type": {
                "type": "string",
                "enum": [
                  "play"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "draw"
                ]
              }
            }
          }
        ]
      },
      "CrazyEightsGameConfig": {
        "type": "object",
        "description": "Optional rank effects; defaults preserve the original Crazy Eights rules.",
        "required": [
          "ace_are_you_strong",
          "jack_skip",
          "ten_reverse",
          "eight_wild",
          "two_draw_two"
        ],
        "properties": {
          "ace_are_you_strong": {
            "type": "boolean"
          },
          "eight_wild": {
            "type": "boolean"
          },
          "jack_skip": {
            "type": "boolean"
          },
          "ten_reverse": {
            "type": "boolean"
          },
          "two_draw_two": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "CrazyEightsPendingDraw": {
        "type": "string",
        "description": "A draw-two obligation: aces permit an ace response; twos do not stack.",
        "enum": [
          "ace",
          "two"
        ]
      },
      "CrazyEightsView": {
        "type": "object",
        "required": [
          "hand",
          "counts",
          "top",
          "suit",
          "stock",
          "reversed"
        ],
        "properties": {
          "counts": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "hand": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Card"
            }
          },
          "pending_draw": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CrazyEightsPendingDraw"
              }
            ]
          },
          "reversed": {
            "type": "boolean"
          },
          "stock": {
            "type": "integer",
            "minimum": 0
          },
          "suit": {
            "$ref": "#/components/schemas/Suit"
          },
          "top": {
            "$ref": "#/components/schemas/Card"
          }
        }
      },
      "CreateRoom": {
        "type": "object",
        "required": [
          "nickname",
          "game"
        ],
        "properties": {
          "config": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Config"
              }
            ]
          },
          "game": {
            "$ref": "#/components/schemas/GameKind"
          },
          "nickname": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "GameConfig": {
        "type": "object",
        "description": "Empty serializable configuration for games without optional rules.",
        "additionalProperties": false
      },
      "GameKind": {
        "type": "string",
        "description": "A registered ruleset and its serialized game identifier.",
        "enum": [
          "mancala",
          "crazy_eights",
          "shithead",
          "skyjo",
          "tic_tac_toe"
        ]
      },
      "JoinRoom": {
        "type": "object",
        "required": [
          "nickname"
        ],
        "properties": {
          "nickname": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "MancalaAction": {
        "type": "object",
        "required": [
          "pit"
        ],
        "properties": {
          "pit": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "MancalaView": {
        "type": "object",
        "required": [
          "board"
        ],
        "properties": {
          "board": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        }
      },
      "Membership": {
        "type": "object",
        "description": "Keep the token private. It grants control of this seat, including after reconnecting.",
        "required": [
          "code",
          "player",
          "token"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "player": {
            "type": "integer",
            "minimum": 0
          },
          "token": {
            "type": "string"
          }
        }
      },
      "Outcome": {
        "type": "object",
        "description": "A finished result with optional scores in seat order.",
        "required": [
          "winners"
        ],
        "properties": {
          "scores": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "description": "Optional final scores; each ruleset determines how they rank."
          },
          "winners": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/usize"
            },
            "description": "Winning seats; empty for a draw, or multiple seats for a shared win."
          }
        }
      },
      "Phase": {
        "type": "string",
        "enum": [
          "setup",
          "draw",
          "place",
          "reveal"
        ]
      },
      "PlayerView": {
        "type": "object",
        "required": [
          "nickname"
        ],
        "properties": {
          "nickname": {
            "type": "string"
          }
        }
      },
      "Record_Action_Event": {
        "type": "object",
        "description": "One accepted action and the ordered effects it produced.",
        "required": [
          "player",
          "action",
          "events"
        ],
        "properties": {
          "action": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "action",
                  "game"
                ],
                "properties": {
                  "action": {
                    "$ref": "#/components/schemas/MancalaAction"
                  },
                  "game": {
                    "type": "string",
                    "enum": [
                      "mancala"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "action",
                  "game"
                ],
                "properties": {
                  "action": {
                    "$ref": "#/components/schemas/CrazyEightsAction"
                  },
                  "game": {
                    "type": "string",
                    "enum": [
                      "crazy_eights"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "action",
                  "game"
                ],
                "properties": {
                  "action": {
                    "$ref": "#/components/schemas/ShitheadAction"
                  },
                  "game": {
                    "type": "string",
                    "enum": [
                      "shithead"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "action",
                  "game"
                ],
                "properties": {
                  "action": {
                    "$ref": "#/components/schemas/SkyjoAction"
                  },
                  "game": {
                    "type": "string",
                    "enum": [
                      "skyjo"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "action",
                  "game"
                ],
                "properties": {
                  "action": {
                    "$ref": "#/components/schemas/TicTacToeAction"
                  },
                  "game": {
                    "type": "string",
                    "enum": [
                      "tic_tac_toe"
                    ]
                  }
                }
              }
            ],
            "description": "A command tagged with the ruleset that understands it."
          },
          "events": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "description": "A player performed an accepted action.",
                  "required": [
                    "player",
                    "type"
                  ],
                  "properties": {
                    "player": {
                      "$ref": "#/components/schemas/usize"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "played"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "description": "A player captured pieces from the board.",
                  "required": [
                    "player",
                    "count",
                    "type"
                  ],
                  "properties": {
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "player": {
                      "$ref": "#/components/schemas/usize"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "captured"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "description": "The current play pile was removed from the game.",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "burned"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "description": "A matching column was removed from a player's layout.",
                  "required": [
                    "player",
                    "column",
                    "type"
                  ],
                  "properties": {
                    "column": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "player": {
                      "$ref": "#/components/schemas/usize"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "column_removed"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "description": "The session reached its final outcome.",
                  "required": [
                    "outcome",
                    "type"
                  ],
                  "properties": {
                    "outcome": {
                      "$ref": "#/components/schemas/Outcome"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "finished"
                      ]
                    }
                  }
                }
              ],
              "description": "Common rule effects that the included games can record without exposing cards."
            },
            "description": "Rule effects, followed by a terminal event when the game ends."
          },
          "player": {
            "$ref": "#/components/schemas/usize",
            "description": "The seat that submitted the action."
          }
        }
      },
      "Replay": {
        "type": "object",
        "description": "Includes hidden information; only share after the game has ended.",
        "required": [
          "version",
          "game",
          "players",
          "seed",
          "records"
        ],
        "properties": {
          "config": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Config",
                "description": "Explicit rules for version 2; absent from legacy version-1 files."
              }
            ]
          },
          "game": {
            "$ref": "#/components/schemas/GameKind",
            "description": "The ruleset needed to interpret the history."
          },
          "players": {
            "type": "integer",
            "description": "The number of seats present at setup.",
            "minimum": 0
          },
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Record_Action_Event"
            },
            "description": "Accepted commands and their expected effects in execution order."
          },
          "seed": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            },
            "description": "The original seed, sufficient to reconstruct hidden card order.",
            "maxItems": 32,
            "minItems": 32
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Version 1 uses original defaults; version 2 includes explicit configuration.",
            "minimum": 0
          }
        }
      },
      "ServerMessage": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "room",
              "type"
            ],
            "properties": {
              "room": {
                "$ref": "#/components/schemas/Snapshot"
              },
              "type": {
                "type": "string",
                "enum": [
                  "snapshot"
