{
  "name": "arena-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "api:generate": "openapi-typescript ../openapi.json -o src/lib/api.generated.ts && prettier --write src/lib/api.generated.ts",
    "test": "playwright test",
    "format": "prettier --write src tests *.ts *.json index.html"
  },
  "dependencies": {
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.5",
    "@types/node": "^22.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte-check": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
